# Copy and fill these files with real values:
#
#   cp secrets/.env.secrets.example secrets/jwt_secret.txt
#   echo "your_secret" > secrets/jwt_secret.txt
#
# Required secrets:
#   secrets/jwt_secret.txt            - JWT signing secret
#   secrets/cloudinary_api_secret.txt - Cloudinary API secret
#   secrets/postgres_password.txt     - PostgreSQL password
#   secrets/pgadmin_password.txt      - pgAdmin web password
