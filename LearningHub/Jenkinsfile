pipeline {
  agent any

  // TODO: re-enable after GitHub Server is configured in Manage Jenkins
  // triggers { githubPush() }

  environment {
    IMAGE_NAME        = 'learninghub-api'
    COMPOSE_FILE      = 'docker-compose.yml'
    PROJECT_DIR       = 'LearningHub'
    POSTGRES_USER     = 'postgres'
    POSTGRES_PASSWORD = 'postgres'
    POSTGRES_DB       = 'dev_learning_hub'
    POSTGRES_TEST_DB  = 'test_learning_hub'
    POSTGRES_HOST     = 'test-postgres'
    POSTGRES_PORT     = '5432'
    REDIS_HOST        = 'test-redis'
    REDIS_PORT        = '6379'
    JWT_SECRET        = credentials('jwt-secret')
    CLOUDINARY_CLOUD_NAME = 'test'
    CLOUDINARY_API_KEY    = 'test'
    CLOUDINARY_API_SECRET = credentials('cloudinary-api-secret')
  }

  stages {
    stage('Install') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm install --frozen-lockfile'
        }
      }
    }

    stage('Lint') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm nx run-many --target=lint --projects=api,LearningHub,AdminPage --parallel=3'
        }
      }
    }

    stage('Setup Test DB') {
      steps {
        sh '''
          set -e
          sudo docker stop postgres redis 2>/dev/null || true
          sudo docker rm -f test-postgres test-redis 2>/dev/null || true

          echo "=== Starting test-postgres ==="
          sudo docker run -d --name test-postgres \
            --network learning-hub-network \
            -e POSTGRES_USER="${POSTGRES_USER}" \
            -e POSTGRES_PASSWORD="${POSTGRES_PASSWORD}" \
            -e POSTGRES_DB="${POSTGRES_DB}" \
            -p "${POSTGRES_PORT}:5432" \
            postgres:17

          echo "=== Starting test-redis ==="
          sudo docker run -d --name test-redis \
            --network learning-hub-network \
            -p "${REDIS_PORT}:6379" \
            redis:8-alpine

          echo "=== Waiting for PostgreSQL ==="
          for i in $(seq 1 30); do
            if sudo docker exec test-postgres pg_isready -U "${POSTGRES_USER}" -d "${POSTGRES_DB}"; then
              echo "PostgreSQL is ready"
              break
            fi
            echo "Waiting for PostgreSQL... (${i}/30)" && sleep 2
          done

          echo "=== Recreating test database ==="
          sudo docker exec test-postgres psql -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" -c "DROP DATABASE IF EXISTS ${POSTGRES_TEST_DB}"
          sudo docker exec test-postgres psql -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" -c "CREATE DATABASE ${POSTGRES_TEST_DB}"

          echo "=== Waiting for Redis ==="
          for i in $(seq 1 15); do
            if sudo docker exec test-redis redis-cli PING | grep -q PONG; then
              echo "Redis is ready"
              break
            fi
            echo "Waiting for Redis... (${i}/15)" && sleep 1
          done

          echo "=== Running migrations ==="
          cd "${PROJECT_DIR}"
          POSTGRES_DB="${POSTGRES_TEST_DB}" pnpm migration:run

          echo "=== Container status ==="
          sudo docker ps --filter "name=test-" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        '''
      }
    }

    stage('Test (API)') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm nx run-many --target=test --projects=api'
        }
      }
    }

    stage('Test (Frontend)') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm nx run-many --target=test --projects=LearningHub,AdminPage'
        }
      }
    }

    stage('Build') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm nx run-many --target=build --projects=api,LearningHub,AdminPage --parallel=3'
        }
      }
    }

    stage('Docker Build & Deploy') {
      when { branch 'main' }
      steps {
        dir(PROJECT_DIR) {
          sh """
            sudo docker build -f apps/api/Dockerfile         -t learninghub-api:latest .
            sudo docker build -f apps/LearningHub/Dockerfile -t learninghub-web:latest .
            sudo docker build -f apps/AdminPage/Dockerfile   -t learninghub-admin:latest .
            sudo docker compose -f ${COMPOSE_FILE} up -d --scale api=3
          """
        }
      }
    }

    stage('E2E Tests') {
      when { branch 'main' }
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm test:e2e'
        }
      }
    }
  }

  post {
    always {
      sh '''
        sudo docker rm -f test-postgres test-redis 2>/dev/null || true
        sudo docker start postgres redis 2>/dev/null || true
      '''
    }
    failure { echo 'Pipeline FAILED' }
    success { echo 'Pipeline PASSED' }
  }
}
