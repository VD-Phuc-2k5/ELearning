pipeline {
  agent any

  // TODO: re-enable after GitHub Server is configured in Manage Jenkins
  // triggers { githubPush() }

  environment {
    IMAGE_NAME        = 'learninghub-api'
    COMPOSE_FILE      = 'docker-compose.yml'
    PROJECT_DIR       = 'LearningHub'
    POSTGRES_USER     = 'postgres'
    POSTGRES_PASSWORD = 'postgres'
    POSTGRES_DB       = 'dev_learning_hub'
    POSTGRES_TEST_DB  = 'test_learning_hub'
    POSTGRES_HOST     = 'localhost'
    POSTGRES_PORT     = '5432'
    REDIS_HOST        = 'localhost'
    REDIS_PORT        = '6379'
  }

  stages {
    stage('Install') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm install --frozen-lockfile'
        }
      }
    }

    stage('Lint') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm nx run-many --target=lint --projects=api,LearningHub,AdminPage --parallel=3'
        }
      }
    }

    stage('Setup Test DB') {
      steps {
        sh '''
          sudo docker stop postgres redis 2>/dev/null || true
          sudo docker rm -f test-postgres test-redis 2>/dev/null || true
          sudo docker run -d --name test-postgres \
            -e POSTGRES_USER="${POSTGRES_USER}" \
            -e POSTGRES_PASSWORD="${POSTGRES_PASSWORD}" \
            -e POSTGRES_DB="${POSTGRES_DB}" \
            -p "${POSTGRES_PORT}:5432" \
            postgres:17
          sudo docker run -d --name test-redis \
            -p "${REDIS_PORT}:6379" \
            redis:8-alpine
          for i in $(seq 1 30); do
            if sudo docker exec test-postgres pg_isready -U "${POSTGRES_USER}" -d "${POSTGRES_DB}"; then break; fi
            echo "Waiting for PostgreSQL..." && sleep 2
          done
          sudo docker exec test-postgres psql -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" -c "CREATE DATABASE ${POSTGRES_TEST_DB}" 2>/dev/null || true
        '''
      }
    }

    stage('Test (API)') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm nx run-many --target=test --projects=api'
        }
      }
    }

    stage('Test (Frontend)') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm nx run-many --target=test --projects=LearningHub,AdminPage'
        }
      }
    }

    stage('Build') {
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm nx run-many --target=build --projects=api,LearningHub,AdminPage --parallel=3'
        }
      }
    }

    stage('Docker Build & Deploy') {
      when { branch 'main' }
      steps {
        dir(PROJECT_DIR) {
          sh """
            sudo docker build -f apps/api/Dockerfile         -t learninghub-api:latest .
            sudo docker build -f apps/LearningHub/Dockerfile -t learninghub-web:latest .
            sudo docker build -f apps/AdminPage/Dockerfile   -t learninghub-admin:latest .
            sudo docker compose -f ${COMPOSE_FILE} up -d --scale api=3
          """
        }
      }
    }

    stage('E2E Tests') {
      when { branch 'main' }
      steps {
        dir(PROJECT_DIR) {
          sh 'pnpm test:e2e'
        }
      }
    }
  }

  post {
    always {
      sh '''
        sudo docker rm -f test-postgres test-redis 2>/dev/null || true
        sudo docker start postgres redis 2>/dev/null || true
      '''
    }
    failure { echo 'Pipeline FAILED' }
    success { echo 'Pipeline PASSED' }
  }
}
